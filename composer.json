{
    "name": "obelaw/twist",
    "description": "Modular Filament v5 Admin Panel & Addon Architecture for Obelawium ERP",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "obelaw",
        "twist",
        "filament",
        "filament-v5",
        "livewire",
        "erp",
        "modular",
        "laravel"
    ],
    "authors": [
        {
            "name": "Karim Mohamed",
            "email": "komicho1996@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.0",
        "laravel/framework": "^11.0|^12.0|^13.0",
        "obelaw/ium": "^1.0"
    },
    "require-dev": {
        "obelaw/ium-tenancy": "^1.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "suggest": {
        "obelaw/ium-tenancy": "Enable Database-per-Tenant isolation for Filament panels via TwistPanel::tenancy() (^1.0)."
    },
    "autoload": {
        "psr-4": {
            "Obelaw\\": "addons/",
            "Obelaw\\Twist\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Obelaw\\Twist\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Obelaw\\Twist\\TwistServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
